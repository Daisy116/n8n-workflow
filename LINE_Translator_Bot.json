        "jsonBody": "={{\n  JSON.stringify({\n    replyToken: $('LineWebhook').first().json.event.replyToken,\n    messages: [\n      {\n        type: \"flex\",\n        altText: \"LINE 翻譯助手功能選單\",\n        contents: {\n          type: \"bubble\",\n          size: \"mega\",\n          header: {\n            type: \"box\",\n            layout: \"vertical\",\n            backgroundColor: \"#166B52\",\n            paddingAll: \"20px\",\n            spacing: \"md\",\n            contents: [\n              {\n                type: \"text\",\n                text: \"TRANSLATION ASSISTANT\",\n                size: \"xs\",\n                color: \"#DDF4E8\",\n                weight: \"bold\"\n              },\n              {\n                type: \"text\",\n                text: \"LINE 翻譯助手\",\n                size: \"xl\",\n                weight: \"bold\",\n                color: \"#FFFFFF\"\n              },\n              {\n                type: \"text\",\n                text: \"讓跨語言溝通更簡單\",\n                size: \"sm\",\n                color: \"#E3F4E9\"\n              }\n            ]\n          },\n          body: {\n            type: \"box\",\n            layout: \"vertical\",\n            backgroundColor: \"#FFFFFF\",\n            paddingAll: \"18px\",\n            spacing: \"lg\",\n            contents: [\n              {\n                type: \"box\",\n                layout: \"vertical\",\n                backgroundColor: \"#F1F7F3\",\n                cornerRadius: \"12px\",\n                paddingAll: \"14px\",\n                spacing: \"sm\",\n                contents: [\n                  {\n                    type: \"text\",\n                    text: \"目前翻譯語言\",\n                    size: \"xs\",\n                    color: \"#678275\"\n                  },\n                  {\n                    type: \"text\",\n                    text: (() => {\n                      const languages = {\n                        ja: \"日文 Japanese\",\n                        en: \"英文 English\",\n                        ko: \"韓文 Korean\",\n                        \"zh-TW\": \"繁體中文\",\n                        \"zh-CN\": \"簡體中文\",\n                        fr: \"法文 French\",\n                        de: \"德文 German\",\n                        es: \"西班牙文 Spanish\"\n                      };\n\n                      const code = $json.targetLanguage;\n\n                      return code\n                        ? languages[code] ?? code\n                        : \"尚未設定（預設英文）\";\n                    })(),\n                    size: \"lg\",\n                    weight: \"bold\",\n                    color: \"#1A4B38\",\n                    wrap: true\n                  }\n                ]\n              },\n              {\n                type: \"text\",\n                text: \"直接傳送文字，即可自動翻譯成指定語言。\",\n                size: \"sm\",\n                color: \"#75857C\",\n                wrap: true\n              }\n            ]\n          },\n          footer: {\n            type: \"box\",\n            layout: \"vertical\",\n            backgroundColor: \"#FFFFFF\",\n            paddingAll: \"16px\",\n            spacing: \"sm\",\n            contents: [\n              {\n                type: \"button\",\n                style: \"primary\",\n                color: \"#16805C\",\n                height: \"md\",\n                action: {\n                  type: \"message\",\n                  label: \"設定翻譯語言\",\n                  text: \"@lang\"\n                }\n              },\n              {\n                type: \"button\",\n                style: \"secondary\",\n                color: \"#EAF3EE\",\n                height: \"md\",\n                action: {\n                  type: \"message\",\n                  label: \"使用說明\",\n                  text: \"@help\"\n                }\n              },\n              {\n                type: \"text\",\n                text: \"POWERED BY GOOGLE CLOUD TRANSLATION\",\n                color: \"#81948A\",\n                size: \"xxs\",\n                align: \"center\",\n                margin: \"md\",\n                wrap: true\n              }\n            ]\n          }\n        }\n      }\n    ]\n  })\n}}",
