      "name": "Check LINE Reply Result"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const event = $('LineWebhook').first().json.event;\n\n// 取得 HTTP Request 的錯誤資訊\nconst error = $json.error ?? {};\n\nconst rawMessage = String(\n  typeof error === \"string\"\n    ? error\n    : error.message ?? \"Unknown LINE API error\"\n);\n\n// 分類錯誤\nlet errorType = \"unknown\";\n\nif (/timeout|timed out|ETIMEDOUT/i.test(rawMessage)) {\n  errorType = \"timeout\";\n}\nelse if (/401|403|unauthorized|forbidden/i.test(rawMessage)) {\n  errorType = \"authentication\";\n}\nelse if (/400|404|bad request|not found/i.test(rawMessage)) {\n  errorType = \"request_error\";\n}\nelse if (/429|rate limit/i.test(rawMessage)) {\n  errorType = \"rate_limit\";\n}\nelse if (/500|502|503|server error/i.test(rawMessage)) {\n  errorType = \"server_error\";\n}\n\n// 使用固定摘要，避免將 API Token 等敏感內容寫入日誌\nconst descriptions = {\n  timeout: \"LINE API request timed out\",\n  authentication: \"LINE API authentication failed\",\n  request_error: \"LINE API rejected the request\",\n  rate_limit: \"LINE API rate limit exceeded\",\n  server_error: \"LINE API server error\",\n  unknown: \"LINE API request failed\"\n};\n\nreturn {\n  json: {\n    eventId: event.webhookEventId ?? \"\",\n    messageId: event.message?.id ?? \"\",\n    failedNode: \"Send Quoted Translation\",\n    errorType,\n    errorMessage: descriptions[errorType],\n    occurredAt: new Date().toISOString()\n  }\n};"
      },
