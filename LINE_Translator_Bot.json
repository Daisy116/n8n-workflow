    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\nconst message = $json.event.message.text;\nconst userId = $json.event.source?.userId;\n\n// 取出 @lang 後面的語言代碼\nconst targetLanguage = message\n  .trim()\n  .split(/\\s+/)[1]\n  ?.toLowerCase();\n\n// 支援的語言\nconst supportedLanguages = {\n  \"ja\": \"日文\",\n  \"en\": \"英文\",\n  \"ko\": \"韓文\",\n  \"zh-tw\": \"繁體中文\",\n  \"zh-cn\": \"簡體中文\",\n  \"fr\": \"法文\",\n  \"de\": \"德文\",\n  \"es\": \"西班牙文\"\n};\n\n// 檢查語言代碼是否有效\nconst isValid = Object.hasOwn(\n  supportedLanguages,\n  targetLanguage ?? \"\"\n);\n\nreturn {\n  json: {\n    userId,\n    targetLanguage: isValid\n      ? targetLanguage === \"zh-tw\"\n        ? \"zh-TW\"\n        : targetLanguage === \"zh-cn\"\n          ? \"zh-CN\"\n          : targetLanguage\n      : null,\n    languageName: isValid\n      ? supportedLanguages[targetLanguage]\n      : null,\n    isValid,\n    replyToken: $json.event.replyToken\n  }\n};\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
        -112
      ],
      "id": "2b32b6fc-f37d-4777-a9b4-511a383904d2",
