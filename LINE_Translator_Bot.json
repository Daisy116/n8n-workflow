        "jsonBody": "={{\n  JSON.stringify({\n    replyToken: $('LineWebhook').first().json.event.replyToken,\n    messages: [\n      {\n        type: \"text\",\n        text: \"請選擇要翻譯成哪種語言：\",\n        quickReply: {\n          items: [\n            { label: \"日文\", code: \"ja\" },\n            { label: \"英文\", code: \"en\" },\n            { label: \"韓文\", code: \"ko\" },\n            { label: \"繁體中文\", code: \"zh-TW\" },\n            { label: \"簡體中文\", code: \"zh-CN\" },\n            { label: \"法文\", code: \"fr\" },\n            { label: \"德文\", code: \"de\" },\n            { label: \"西班牙文\", code: \"es\" }\n          ].map(lang => ({\n            type: \"action\",\n            action: {\n              type: \"message\",\n              label: lang.label,\n              text: `@lang ${lang.code}`\n            }\n          }))\n        }\n      }\n    ]\n  })\n}}",
        "options": {}
