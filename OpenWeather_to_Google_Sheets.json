    {
      "parameters": {
        "jsCode": "const locations = [\n  {\n    name: \"彰化縣和美鎮\",\n    latitude: 24.11,\n    longitude: 120.50\n  },\n  {\n    name: \"臺中市大甲區\",\n    latitude: 24.3489,\n    longitude: 120.6224\n  }\n];\n\nreturn locations.map(location => ({\n  json: location\n}));\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -208,
        112
      ],
      "id": "96f16ce8-0a2d-4716-a277-64b68b950010",
      "name": "Code：建立地區清單"
    },
    {
      "parameters": {
        "options": {
          "reset": false
        }
      },
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        -32,
        112
      ],
      "id": "38e719cc-4dc5-4e32-a5c7-4a542e7d1a93",
      "name": "Loop Over Items"
    },
    {
      "parameters": {
        "operation": "5DayForecast",
        "locationSelection": "coordinates",
        "latitude": "={{ $json.latitude }}",
        "longitude": "={{ $json.longitude }}",
        "language": "zh_tw"
      },
      "type": "n8n-nodes-base.openWeatherMap",
      "typeVersion": 1,
      "position": [
        192,
        128
      ],
      "id": "e2cdc03a-2f74-44e1-bfd5-df748d682292",
      "name": "OpenWeatherMap - 取得各地區天氣預報",
      "retryOnFail": true,
      "waitBetweenTries": 2000,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const inputItems = $input.all();\n\n// 取得 OpenWeather API 回傳的資料\nconst data = inputItems[0]?.json;\n\n// 1. 檢查基本資料結構\nif (!data || !data.city || !Array.isArray(data.list)) {\n  throw new Error(\"OpenWeather 回傳格式錯誤：缺少 city 或 list\");\n}\n\n// 2. 檢查時區資料\nif (!Number.isFinite(data.city.timezone)) {\n  throw new Error(\"OpenWeather 回傳格式錯誤：timezone 無效\");\n}\n\n// 3. 檢查是否有預報資料\nif (data.list.length === 0) {\n  throw new Error(\"OpenWeather 沒有回傳任何天氣預報\");\n}\n\n// 4. 逐筆檢查天氣預報\nfor (let i = 0; i < data.list.length; i++) {\n  const item = data.list[i];\n\n  if (!Number.isFinite(item?.dt)) {\n    throw new Error(`第 ${i + 1} 筆：預報時間無效`);\n  }\n\n  if (!Number.isFinite(item?.main?.temp)) {\n    throw new Error(`第 ${i + 1} 筆：氣溫資料無效`);\n  }\n\n  if (\n    !Number.isFinite(item?.pop) ||\n    item.pop < 0 ||\n    item.pop > 1\n  ) {\n    throw new Error(`第 ${i + 1} 筆：降雨機率無效`);\n  }\n\n  if (\n    typeof item?.weather?.[0]?.description !== \"string\" ||\n    !item.weather[0].description.trim()\n  ) {\n    throw new Error(`第 ${i + 1} 筆：天氣描述缺失`);\n  }\n}\n\n// 5. 全部通過，將原始資料交給下一個節點\nreturn inputItems;\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
        112
      ],
      "id": "cd19dd54-cc40-4ae3-bea0-90d8a3fd67b0",
      "name": "驗證 OpenWeather 資料",
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\n\n// 目前這個 Code Node 是第幾次執行\n// 第一輪為 0，第二輪為 1\nconst locationIndex = $runIndex;\n\n// 取得建立地區清單 Node 的所有資料\nconst locationItems =\n  $(\"Code：建立地區清單\").all();\n\n// 根據目前執行輪次取得地區名稱\nconst locationName =\n  locationItems[locationIndex]?.json.name;\n\n// 找不到名稱時，顯示詳細錯誤\nif (!locationName) {\n  throw new Error(\n    `找不到地區名稱：目前第 ${locationIndex} 輪，` +\n    `地區清單共有 ${locationItems.length} 筆`\n  );\n}\n\n\n// 記錄這次取得並整理天氣資料的時間（台灣時間）\nconst updatedAt = $now\n  .setZone(\"Asia/Taipei\")\n  .toFormat(\"yyyy-MM-dd HH:mm:ss\");\n\n// 1. 取得 API 的時區偏移量（台灣為 +28800 秒）\nconst timezone = data.city.timezone;\n\n// 2. 將 UTC 時間轉成當地日期與小時\nconst forecasts = data.list.map(item => {\n  const localDate = new Date(\n    (item.dt + timezone) * 1000\n  );\n\n  return {\n    date: localDate.toISOString().slice(0, 10),\n    time: localDate.toISOString().slice(11, 16),\n    hour: localDate.getUTCHours(),\n    temp: item.main.temp,\n    pop: item.pop * 100,\n    weather: item.weather[0].description\n  };\n});\n\n// 3. 依日期分組\nconst grouped = {};\n\nfor (const item of forecasts) {\n  if (!grouped[item.date]) {\n    grouped[item.date] = [];\n  }\n\n  grouped[item.date].push(item);\n}\n\n// 4. 常用統計函式\nconst average = values =>\n  Math.round(\n    values.reduce((sum, n) => sum + n, 0)\n    / values.length * 10\n  ) / 10;\n\nconst mainWeather = items => {\n  const counts = {};\n\n  for (const item of items) {\n    counts[item.weather] =\n      (counts[item.weather] ?? 0) + 1;\n  }\n\n  return Object.keys(counts).sort(\n    (a, b) => counts[b] - counts[a]\n  )[0];\n};\n\n// 5. 計算早上、下午、晚上的資料\nfunction periodSummary(items, start, end) {\n  const selected = items.filter(\n    item => item.hour >= start && item.hour < end\n  );\n\n  if (selected.length === 0) {\n    return null;\n  }\n\n  return {\n    平均氣溫: average(selected.map(x => x.temp)),\n    平均降雨機率: average(selected.map(x => x.pop)),\n    天氣描述: mainWeather(selected),\n    預報時間: selected.map(x => x.time)\n  };\n}\n\n// 6. 每個日期產生一個 n8n Item\nreturn Object.keys(grouped)\n  .sort()\n  .slice(0, 5)\n  .map(date => {\n    const items = grouped[date];\n\n    return {\n      json: {\n        唯一識別碼: `${date}_${locationName}`,\n        日期: date,\n        updatedAt: updatedAt,\n        早上: periodSummary(items, 6, 12),\n        下午: periodSummary(items, 12, 18),\n        晚上: periodSummary(items, 18, 24),\n        當日摘要: {\n          最低氣溫: Math.round(\n            Math.min(...items.map(x => x.temp)) * 10\n          ) / 10,\n          最高氣溫: Math.round(\n            Math.max(...items.map(x => x.temp)) * 10\n          ) / 10,\n          平均降雨機率: average(items.map(x => x.pop)),\n          最高時段降雨機率: Math.max(...items.map(x => x.pop)),\n          主要天氣: mainWeather(items),\n          預報筆數: items.length,\n          全天資料完整: items.length === 8\n        }\n      }\n    };\n  });\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        608,
        96
      ],
      "id": "b4836aeb-8918-418f-a783-929829b2a54b",
      "name": "Code：整理各地區天氣預報",
      "onError": "continueErrorOutput"
    },
